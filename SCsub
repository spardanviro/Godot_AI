#!/usr/bin/env python
from misc.utility.scons_hints import *

import glob
import os

import ai_knowledge_builders

Import("env")
Import("env_modules")

env_ai = env_modules.Clone()

# Prompts, gotchas and API notes live in knowledge/ as plain files. They are
# embedded as defaults; at runtime a directory of files can override them, so
# iterating on a prompt does not need a rebuild.
knowledge_root = env.Dir("knowledge").srcnode().abspath
knowledge_files = sorted(
    path for path in glob.glob(os.path.join(knowledge_root, "**", "*.md"), recursive=True) if os.path.isfile(path)
)
env_ai.CommandNoCache(
    "prompt/ai_knowledge_data.gen.h",
    knowledge_files,
    env.Run(ai_knowledge_builders.knowledge_builder),
)

# Context windows, output limits and thinking settings of the models, from
# models.dev (update_model_specs.py refreshes the file; the editor also
# downloads newer data on its own).
env_ai.CommandNoCache(
    "providers/ai_model_specs_data.gen.h",
    env.File("data/model_specs.json").srcnode().abspath,
    env.Run(ai_knowledge_builders.model_specs_builder),
)

env_ai.add_source_files(env.modules_sources, "*.cpp")
for folder in ("common", "ui", "agent", "execution", "prompt", "network", "providers", "assets", "tools"):
    env_ai.add_source_files(env.modules_sources, folder + "/*.cpp")
