[
  {
    "id": "tools.inspect_then_act",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D",
      "nodes": [
        {
          "path": "Player",
          "class": "CharacterBody2D",
          "properties": {
            "position": "Vector2(120, 80)"
          }
        }
      ]
    },
    "prompt": "Add a Marker2D named Spawn at the player's current position.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Spawn"
      },
      {
        "type": "property",
        "path": "Spawn",
        "property": "position",
        "equals": "Vector2(120, 80)"
      },
      {
        "type": "tool_calls_equal",
        "value": 2
      },
      {
        "type": "retries_equal",
        "value": 0
      },
      {
        "type": "requests_max",
        "value": 3
      }
    ],
    "mock_replies": [
      {
        "requires_tools": true,
        "tool_calls": [
          {
            "name": "get_node_properties",
            "arguments": {
              "path": "Player",
              "properties": [
                "position"
              ]
            }
          }
        ]
      },
      {
        "requires_tool_result": "position = Vector2(120, 80)",
        "tool_calls": [
          {
            "name": "create_node",
            "arguments": {
              "class": "Marker2D",
              "name": "Spawn",
              "properties": {
                "position": "Vector2(120, 80)"
              }
            }
          }
        ]
      },
      {
        "requires_tool_result": "Created Spawn",
        "text": "Added Spawn at the player's position."
      }
    ],
    "mock_only": true
  },
