  {
    "id": "tools.build_scene",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Add a player: a CharacterBody2D at (200, 300) with a sprite and a 32x48 rectangle collision shape, in group \"players\".",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "no_execution"
      },
      {
        "type": "node_exists",
        "path": "Player/Sprite2D"
      },
      {
        "type": "property",
        "path": "Player",
        "property": "position",
        "equals": "Vector2(200, 300)"
      },
      {
        "type": "expression",
        "code": "root.get_node(\"Player/Shape\").shape.is_class(\"RectangleShape2D\") and root.get_node(\"Player/Shape\").shape.size == Vector2(32, 48)"
      },
      {
        "type": "expression",
        "code": "root.get_node(\"Player\").is_in_group(\"players\")"
      },
      {
        "type": "property",
        "path": "Player/Sprite2D",
        "property": "modulate",
        "equals": "Color(1, 0, 0, 1)"
      },
      {
        "type": "all_nodes_owned"
      },
      {
        "type": "tool_calls_equal",
        "value": 4
      },
      {
        "type": "retries_equal",
        "value": 0
      },
      {
        "type": "expression",
        "code": "undo_last() and root.get_node(\"Player/Sprite2D\").modulate == Color(1, 1, 1, 1)"
      },
      {
        "type": "expression",
        "code": "undo_last() and root.get_node_or_null(\"Player/Shape\") == null and root.get_node_or_null(\"Player\") != null"
      }
    ],
    "mock_replies": [
      {
        "requires_tools": true,
        "tool_calls": [
          {
            "name": "create_node",
            "arguments": {
              "class": "CharacterBody2D",
              "name": "Player",
              "properties": {
                "position": "Vector2(200, 300)"
              },
              "groups": [
                "players"
              ]
            }
          },
          {
            "name": "create_node",
            "arguments": {
              "parent": "Player",
              "class": "Sprite2D"
            }
          },
          {
            "name": "create_node",
            "arguments": {
              "parent": "Player",
              "name": "Shape",
              "class": "CollisionShape2D",
              "properties": {
                "shape": {
                  "$resource": "RectangleShape2D",
                  "size": [
                    32,
                    48
                  ]
                }
              }
            }
          }
        ]
      },
      {
        "requires_tool_result": "Created Player/Shape (CollisionShape2D).",
        "tool_calls": [
          {
            "name": "set_node_properties",
            "arguments": {
              "path": "Player/Sprite2D",
              "properties": {
                "modulate": "#ff0000"
              }
            }
          }
        ]
      },
      {
        "requires_tool_result": "modulate = Color(1, 0, 0, 1)",
        "text": "Added the player with a sprite and a 32x48 collision shape."
      }
    ],
    "mock_only": true
  },
  {
    "id": "tools.write_attach_connect",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D",
      "nodes": [
        {
          "path": "Start",
          "class": "Button"
        }
      ]
    },
    "prompt": "Make the scene root move right by its speed when Start is pressed.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "no_execution"
      },
      {
        "type": "file_contains",
        "file": "res://scripts/mover.gd",
        "text": "func _on_start_pressed"
      },
      {
        "type": "script_compiles",
        "file": "res://scripts/mover.gd"
      },
      {
        "type": "has_script",
        "path": "."
      },
      {
        "type": "expression",
        "code": "connected(\"Start\", \"pressed\", \".\", \"_on_start_pressed\")"
      },
      {
        "type": "tool_calls_equal",
        "value": 3
      }
    ],
    "mock_replies": [
      {
        "tool_calls": [
          {
            "name": "write_file",
            "arguments": {
              "path": "res://scripts/mover.gd",
              "content": "extends Node2D\n\n@export var speed: float = 120.0\n\n\nfunc _on_start_pressed() -> void:\n\tposition.x += speed\n"
            }
          }
        ]
      },
      {
        "requires_tool_result": "Created res://scripts/mover.gd",
        "tool_calls": [
          {
            "name": "attach_script",
            "arguments": {
              "path": ".",
              "script": "res://scripts/mover.gd"
            }
          },
          {
            "name": "connect_signal",
            "arguments": {
              "source": "Start",
              "signal": "pressed",
              "target": ".",
              "method": "_on_start_pressed"
            }
          }
        ]
      },
      {
        "requires_tool_result": "Connected Start.pressed -> Main._on_start_pressed().",
        "text": "Done: pressing Start moves the root."
      }
    ],
    "mock_only": true
  },
  {
    "id": "tools.broken_script_is_not_written",
    "mode": "agent",
