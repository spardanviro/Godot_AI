    "mock_replies": [
      {
        "tool_calls": [
          {
            "name": "write_file",
            "arguments": {
              "path": "res://scripts/three.gd",
              "content": "extends Node\n\nfunc _ready() -> void:\n\tvar a = (1 + \n"
            }
          },
          {
            "name": "write_file",
            "arguments": {
              "path": "res://three.gd",
              "content": "extends Node\n\n\nfunc _ready() -> void:\n\tvar a := 1 + 2\n\tprint(a)\n"
            }
          },
          {
            "name": "write_file",
            "arguments": {
              "path": "res://project.godot",
              "content": "[application]\n"
            }
          }
        ]
      },
      {
        "requires_tool_result": "was not written because it does not parse",
        "tool_calls": [
          {
            "name": "write_file",
            "arguments": {
              "path": "res://scripts/three.gd",
              "content": "extends Node\n\n\nfunc _ready() -> void:\n\tvar a := 1 + 2\n\tprint(a)\n"
            }
          }
        ]
      },
      {
        "requires_tool_result": "Created res://scripts/three.gd",
        "text": "Wrote the script."
      }
    ],
    "mock_only": true
  },
