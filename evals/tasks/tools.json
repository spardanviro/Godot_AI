  {
    "id": "tools.move_can_be_undone",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D",
      "nodes": [
        {
          "path": "A",
          "class": "Node2D",
          "properties": {
            "position": "Vector2(100, 0)"
          }
        },
        {
          "path": "B",
          "class": "Sprite2D",
          "properties": {
            "position": "Vector2(30, 40)"
          }
        },
        {
          "path": "B/Glow",
          "class": "Node2D"
        }
      ]
    },
    "prompt": "Rename the node \"A\" to \"Player\" and make \"B\" a child of it.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_missing",
        "path": "B"
      },
      {
        "type": "node_exists",
        "path": "Player/B/Glow"
      },
      {
        "type": "all_nodes_owned"
      },
      {
        "type": "node_count",
        "class": "Sprite2D",
        "min": 1,
        "max": 1
      },
      {
        "type": "property",
        "path": "Player/B",
        "property": "position",
        "equals": "Vector2(-70, 40)"
      },
      {
        "type": "no_execution"
      },
      {
        "type": "expression",
        "code": "undo_last() and root.get_node_or_null(\"B/Glow\") != null and root.get_node(\"B/Glow\").owner == root and root.get_node(\"B\").position == Vector2(30, 40)"
      }
    ],
    "mock_replies": [
      {
        "tool_calls": [
          {
            "name": "rename_node",
            "arguments": {
              "path": "A",
              "name": "Player"
            }
          },
          {
            "name": "move_node",
            "arguments": {
              "path": "Player",
              "parent": "Player"
            }
          },
          {
            "name": "move_node",
            "arguments": {
              "path": "B",
              "parent": "Player"
            }
          }
        ]
      },
      {
        "requires_tool_result": "Moved B to Player/B",
        "text": "Renamed A to Player and moved B under it."
      }
    ],
    "mock_only": true
  },
