[
  {
    "id": "tools.inspect_then_act",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D",
      "nodes": [
        {
          "path": "Player",
          "class": "CharacterBody2D",
          "properties": {
            "position": "Vector2(120, 80)"
          }
        }
      ]
    },
    "prompt": "Add a Marker2D named Spawn at the player's current position.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Spawn"
      },
      {
        "type": "property",
        "path": "Spawn",
        "property": "position",
        "equals": "Vector2(120, 80)"
      },
      {
        "type": "tool_calls_equal",
        "value": 1
      },
      {
        "type": "retries_equal",
        "value": 0
      },
      {
        "type": "requests_max",
        "value": 2
      }
    ],
    "mock_replies": [
      {
        "requires_tools": true,
        "tool_calls": [
          {
            "name": "get_node_properties",
            "arguments": {
              "path": "Player",
              "properties": [
                "position"
              ]
            }
          }
        ]
      },
      {
        "requires_tool_result": "position = Vector2(120, 80)",
        "text": [
          "```gdscript",
          "var root = get_scene()",
          "var spawn = Marker2D.new()",
          "spawn.name = \"Spawn\"",
          "spawn.position = Vector2(120, 80)",
          "root.add_child(spawn)",
          "spawn.owner = root",
          "print(\"Added Spawn at the player's position\")",
          "```"
        ]
      }
    ],
    "mock_only": true
  },
  {
    "id": "tools.read_file_then_act",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D",
      "files": {
        "res://config.json": "{\n\t\"speed\": 321\n}\n"
      }
    },
    "prompt": "Add a Node named after the speed in config.json, like Speed100.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Speed321"
      },
      {
        "type": "tool_calls_equal",
        "value": 2
      }
    ],
    "mock_replies": [
      {
        "tool_calls": [
          {
            "name": "list_files",
            "arguments": {}
          }
        ]
      },
      {
        "requires_tool_result": "config.json",
        "text": "Let me read it.",
        "tool_calls": [
          {
            "name": "read_file",
            "arguments": {
              "path": "res://config.json"
            }
          }
        ]
      },
      {
        "requires_tool_result": "2: \t\"speed\": 321",
        "text": [
          "```gdscript",
          "var root = get_scene()",
          "var node = Node.new()",
          "node.name = \"Speed321\"",
          "root.add_child(node)",
          "node.owner = root",
          "print(\"Added Speed321\")",
          "```"
        ]
      }
    ],
    "mock_only": true
  },
