      },
      {
        "type": "file_contains",
        "file": "res://enemy.gd",
        "text": "match"
      },
      {
        "type": "file_contains",
        "file": "res://enemy.gd",
        "text": "_physics_process"
      },
      {
        "type": "file_contains",
        "file": "res://enemy.gd",
        "text": "State.ATTACK"
      }
