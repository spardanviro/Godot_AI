[
  {
    "id": "script.create_attach",
    "setup": {
      "scene_root": "Node2D",
      "nodes": [
        {
          "path": "Player",
          "class": "CharacterBody2D"
        }
      ]
    },
    "prompt": "Create the script res://player.gd for the Player node: it extends CharacterBody2D and has an exported float variable named speed with a default of 200. Attach it to Player.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "file_exists",
        "file": "res://player.gd"
      },
      {
        "type": "script_compiles",
        "file": "res://player.gd"
      },
      {
        "type": "has_script",
        "path": "Player"
      },
      {
        "type": "file_contains",
        "file": "res://player.gd",
        "text": "@export"
      },
      {
        "type": "file_contains",
        "file": "res://player.gd",
        "text": "speed"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var source = \"extends CharacterBody2D\\n\\n@export var speed: float = 200.0\\n\"",
        "var file = FileAccess.open(\"res://player.gd\", FileAccess.WRITE)",
        "file.store_string(source)",
        "file.close()",
        "get_scene().get_node(\"Player\").set_script(load(\"res://player.gd\"))",
        "print(\"Created res://player.gd and attached it to Player\")",
        "```"
      ]
    ]
  },
  {
    "id": "script.topdown_movement",
    "setup": {
      "scene_root": "Node2D",
      "nodes": [
        {
          "path": "Player",
          "class": "CharacterBody2D"
        }
      ]
    },
    "prompt": "Write res://player.gd for Player (a CharacterBody2D): top-down movement at 200 pixels per second using the ui_left, ui_right, ui_up and ui_down actions. Attach it to Player.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "script_compiles",
        "file": "res://player.gd"
      },
      {
        "type": "has_script",
        "path": "Player"
      },
      {
        "type": "file_contains",
        "file": "res://player.gd",
        "text": "move_and_slide()"
      },
      {
        "type": "file_contains_any",
        "file": "res://player.gd",
        "any": [
          "get_vector",
          "get_axis",
          "is_action_pressed"
        ]
      },
      {
        "type": "file_not_contains",
        "file": "res://player.gd",
        "text": "move_and_slide(velocity"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var source = \"extends CharacterBody2D\\n\\n@export var speed: float = 200.0\\n\\nfunc _physics_process(_delta: float) -> void:\\n\\tvelocity = Input.get_vector(\\\"ui_left\\\", \\\"ui_right\\\", \\\"ui_up\\\", \\\"ui_down\\\") * speed\\n\\tmove_and_slide()\\n\"",
        "var file = FileAccess.open(\"res://player.gd\", FileAccess.WRITE)",
        "file.store_string(source)",
        "file.close()",
        "get_scene().get_node(\"Player\").set_script(load(\"res://player.gd\"))",
        "print(\"Wrote top-down movement to res://player.gd and attached it\")",
        "```"
      ]
    ]
  },
  {
