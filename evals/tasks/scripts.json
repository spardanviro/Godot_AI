  {
    "id": "script.godot3_to_4",
    "setup": {
      "files": {
        "res://legacy.gd": [
          "extends KinematicBody2D",
          "",
          "export var speed = 200",
          "onready var sprite = $Sprite",
          "",
          "func _ready():",
          "\tyield(get_tree().create_timer(1.0), \"timeout\")",
          "\tprint(\"ready\")",
          "",
          "func _physics_process(delta):",
          "\tvar velocity = Vector2.ZERO",
          "\tvelocity.x = speed",
          "\tvelocity = move_and_slide(velocity)"
        ]
      }
    },
    "prompt": "res://legacy.gd is written for Godot 3. Convert it to Godot 4 syntax, keeping its behaviour.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "script_compiles",
        "file": "res://legacy.gd"
      },
      {
        "type": "file_contains",
        "file": "res://legacy.gd",
        "text": "@export"
      },
      {
        "type": "file_contains",
        "file": "res://legacy.gd",
        "text": "@onready"
      },
      {
        "type": "file_contains",
        "file": "res://legacy.gd",
        "text": "await"
      },
      {
        "type": "file_not_contains",
        "file": "res://legacy.gd",
        "text": "yield("
      },
      {
        "type": "file_not_contains",
        "file": "res://legacy.gd",
        "text": "KinematicBody2D"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var source = \"extends CharacterBody2D\\n\\n@export var speed = 200\\n@onready var sprite = $Sprite\\n\\nfunc _ready():\\n\\tawait get_tree().create_timer(1.0).timeout\\n\\tprint(\\\"ready\\\")\\n\\nfunc _physics_process(delta):\\n\\tvelocity = Vector2.ZERO\\n\\tvelocity.x = speed\\n\\tmove_and_slide()\\n\"",
        "var file = FileAccess.open(\"res://legacy.gd\", FileAccess.WRITE)",
        "file.store_string(source)",
        "file.close()",
        "print(\"Converted res://legacy.gd to Godot 4 syntax\")",
        "```"
      ]
    ]
  },
