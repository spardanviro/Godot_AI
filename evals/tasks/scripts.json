    "mock_replies": [
      [
        "```gdscript",
        "var source = \"extends CharacterBody2D\\n\\nenum State { IDLE, CHASE, ATTACK }\\n\\nvar state: State = State.IDLE\\n\\nfunc _physics_process(_delta: float) -> void:\\n\\tmatch state:\\n\\t\\tState.IDLE:\\n\\t\\t\\tvelocity = Vector2.ZERO\\n\\t\\tState.CHASE:\\n\\t\\t\\tmove_and_slide()\\n\\t\\tState.ATTACK:\\n\\t\\t\\tvelocity = Vector2.ZERO\\n\"",
        "var file = FileAccess.open(\"res://enemy.gd\", FileAccess.WRITE)",
        "file.store_string(source)",
        "file.close()",
        "print(\"Created res://enemy.gd with a three-state machine\")",
        "```"
      ]
    ]
