[
  {
    "id": "audio.sfx_player",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Add an AudioStreamPlayer named \"Sfx\" that plays on the Master bus at -6 dB.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Sfx",
        "class": "AudioStreamPlayer"
      },
      {
        "type": "expression",
        "code": "is_equal_approx(node(\"Sfx\").volume_db, -6.0)"
      },
      {
        "type": "expression",
        "code": "node(\"Sfx\").bus == \"Master\""
      },
      {
        "type": "all_nodes_owned"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var node = AudioStreamPlayer.new()",
        "node.name = \"Sfx\"",
        "node.volume_db = -6.0",
        "node.bus = \"Master\"",
        "root.add_child(node)",
        "node.owner = root",
        "print(\"Added Sfx\")",
        "```"
      ]
    ]
  },
  {
    "id": "navigation.region_and_agent",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Set up 2D navigation: a NavigationRegion2D named \"Region\" with a rectangular navigation polygon of 400 by 300 pixels, and a CharacterBody2D named \"Npc\" with a NavigationAgent2D child named \"Agent\".",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Region",
        "class": "NavigationRegion2D"
      },
      {
        "type": "node_exists",
        "path": "Npc",
        "class": "CharacterBody2D"
      },
      {
        "type": "node_exists",
        "path": "Npc/Agent",
        "class": "NavigationAgent2D"
      },
      {
        "type": "expression",
        "code": "node(\"Region\").navigation_polygon != null"
      },
      {
        "type": "expression",
        "code": "node(\"Region\").navigation_polygon.get_outline_count() >= 1 or node(\"Region\").navigation_polygon.get_polygon_count() >= 1"
      },
      {
        "type": "all_nodes_owned"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var region = NavigationRegion2D.new()",
        "region.name = \"Region\"",
        "var polygon = NavigationPolygon.new()",
        "polygon.add_outline(PackedVector2Array([Vector2(0, 0), Vector2(400, 0), Vector2(400, 300), Vector2(0, 300)]))",
        "region.navigation_polygon = polygon",
        "root.add_child(region)",
        "region.owner = root",
        "var npc = CharacterBody2D.new()",
        "npc.name = \"Npc\"",
        "root.add_child(npc)",
        "npc.owner = root",
        "var agent = NavigationAgent2D.new()",
        "agent.name = \"Agent\"",
        "npc.add_child(agent)",
        "agent.owner = root",
        "```"
      ]
    ]
  },
