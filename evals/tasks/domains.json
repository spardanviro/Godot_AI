  {
    "id": "animation.bounce",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Add an AnimationPlayer named \"Anim\" that has an animation called \"bounce\", one second long.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Anim",
        "class": "AnimationPlayer"
      },
      {
        "type": "expression",
        "code": "node(\"Anim\").has_animation(\"bounce\")"
      },
      {
        "type": "expression",
        "code": "is_equal_approx(node(\"Anim\").get_animation(\"bounce\").length, 1.0)"
      },
      {
        "type": "all_nodes_owned"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var player = AnimationPlayer.new()",
        "player.name = \"Anim\"",
        "root.add_child(player)",
        "player.owner = root",
        "var animation = Animation.new()",
        "animation.length = 1.0",
        "var library = AnimationLibrary.new()",
        "library.add_animation(\"bounce\", animation)",
        "player.add_animation_library(\"\", library)",
        "```"
      ]
    ]
  },
  {
    "id": "batch.hide_enemies",
    "setup": {
      "scene_root": "Node2D",
      "nodes": [
        {
          "path": "Enemy1",
          "class": "Node2D"
        },
        {
          "path": "Enemy2",
          "class": "Node2D"
        },
        {
          "path": "Player",
          "class": "Node2D"
        },
        {
          "path": "Enemy3",
          "class": "Node2D"
        }
      ]
    },
    "prompt": "Hide every node in the scene whose name starts with Enemy (set visible to false). Leave the other nodes visible.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "expression",
        "code": "not node(\"Enemy1\").visible and not node(\"Enemy2\").visible and not node(\"Enemy3\").visible"
      },
      {
        "type": "expression",
        "code": "node(\"Player\").visible"
      },
      {
        "type": "node_count",
        "class": "Node2D",
        "min": 5,
        "max": 5
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "for child in root.get_children():",
        "\tif String(child.name).begins_with(\"Enemy\"):",
        "\t\tchild.visible = false",
        "```"
      ]
    ]
  },
  {
    "id": "project.script_in_subfolder",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Create the script res://player/player.gd: it extends CharacterBody2D and exports a float named speed with the default 200.0. Create the folder if it does not exist.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "file_exists",
        "file": "res://player/player.gd"
      },
      {
        "type": "script_compiles",
        "file": "res://player/player.gd"
      },
      {
        "type": "file_contains",
        "file": "res://player/player.gd",
        "text": "extends CharacterBody2D"
      },
      {
        "type": "file_contains",
        "file": "res://player/player.gd",
        "text": "@export"
      },
      {
        "type": "file_contains",
        "file": "res://player/player.gd",
        "text": "speed"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(\"res://player/\"))",
        "var file = FileAccess.open(\"res://player/player.gd\", FileAccess.WRITE)",
        "file.store_string(\"extends CharacterBody2D\\n\\n@export var speed: float = 200.0\\n\")",
        "file.close()",
        "EditorInterface.get_resource_filesystem().scan()",
        "```"
      ]
    ]
  }
]
