  {
    "id": "scene.animation",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Add an AnimationPlayer named \"Anim\" with an animation called \"idle\" that lasts 1 second.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Anim",
        "class": "AnimationPlayer"
      },
      {
        "type": "expression",
        "code": "node(\"Anim\").has_animation(\"idle\") and is_equal_approx(node(\"Anim\").get_animation(\"idle\").length, 1.0)"
      },
      {
        "type": "all_nodes_owned"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var player = AnimationPlayer.new()",
        "player.name = \"Anim\"",
        "root.add_child(player)",
        "player.owner = root",
        "",
        "var animation = Animation.new()",
        "animation.length = 1.0",
        "var library = AnimationLibrary.new()",
        "library.add_animation(\"idle\", animation)",
        "player.add_animation_library(\"\", library)",
        "print(\"Added AnimationPlayer 'Anim' with a 1 s 'idle' animation\")",
        "```"
      ]
    ]
  }
]
