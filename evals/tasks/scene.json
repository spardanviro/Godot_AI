  {
    "id": "scene.rename_reparent",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D",
      "nodes": [
        {
          "path": "A",
          "class": "Node2D"
        },
        {
          "path": "B",
          "class": "Sprite2D"
        }
      ]
    },
    "prompt": "Rename the node \"A\" to \"Player\" and make \"B\" a child of it.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Player"
      },
      {
        "type": "node_exists",
        "path": "Player/B",
        "class": "Sprite2D"
      },
      {
        "type": "node_missing",
        "path": "A"
      },
      {
        "type": "node_missing",
        "path": "B"
      },
      {
        "type": "all_nodes_owned"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var a = root.get_node(\"A\")",
        "var b = root.get_node(\"B\")",
        "a.name = \"Player\"",
        "b.reparent(a)",
        "b.owner = root",
        "print(\"Renamed A to Player and moved B under it\")",
        "```"
      ]
    ]
  },
  {
    "id": "scene.delete_node",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D",
      "nodes": [
        {
          "path": "Obsolete",
          "class": "Node2D"
        },
        {
          "path": "Keep",
          "class": "Node2D"
        }
      ]
    },
    "prompt": "Delete the node named \"Obsolete\". Leave everything else alone.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_missing",
        "path": "Obsolete"
      },
      {
        "type": "node_exists",
        "path": "Keep"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var node = root.get_node(\"Obsolete\")",
        "root.remove_child(node)",
        "node.queue_free()",
        "print(\"Deleted node 'Obsolete'\")",
        "```"
      ]
    ]
  },
  {
