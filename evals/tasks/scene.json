[
  {
    "id": "scene.add_sprite",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Add a Sprite2D named \"Logo\" to the scene at position (100, 50).",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Logo",
        "class": "Sprite2D"
      },
      {
        "type": "property",
        "path": "Logo",
        "property": "position",
        "equals": "Vector2(100, 50)"
      },
      {
        "type": "all_nodes_owned"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var logo = Sprite2D.new()",
        "logo.name = \"Logo\"",
        "logo.position = Vector2(100, 50)",
        "root.add_child(logo)",
        "logo.owner = root",
        "print(\"Added Sprite2D 'Logo' at (100, 50)\")",
        "```"
      ]
    ]
  },
  {
    "id": "scene.player_2d",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Create a 2D player: a CharacterBody2D named \"Player\" with a CollisionShape2D child that has a rectangle shape, and a Camera2D child.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Player",
        "class": "CharacterBody2D"
      },
      {
        "type": "node_count",
        "class": "CollisionShape2D",
        "min": 1
      },
      {
        "type": "node_count",
        "class": "Camera2D",
        "min": 1
      },
      {
        "type": "expression",
        "code": "find(\"CollisionShape2D\")[0].shape != null and find(\"CollisionShape2D\")[0].shape.is_class(\"RectangleShape2D\")"
      },
      {
        "type": "expression",
        "code": "find(\"CollisionShape2D\")[0].get_parent().name == \"Player\" and find(\"Camera2D\")[0].get_parent().name == \"Player\""
      },
      {
        "type": "all_nodes_owned"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var player = CharacterBody2D.new()",
        "player.name = \"Player\"",
        "root.add_child(player)",
        "player.owner = root",
        "",
        "var collision = CollisionShape2D.new()",
        "collision.name = \"CollisionShape2D\"",
        "var shape = RectangleShape2D.new()",
        "shape.size = Vector2(32, 48)",
        "collision.shape = shape",
        "player.add_child(collision)",
        "collision.owner = root",
        "",
        "var camera = Camera2D.new()",
        "camera.name = \"Camera2D\"",
        "player.add_child(camera)",
        "camera.owner = root",
        "print(\"Created Player with a rectangle collision shape and a camera\")",
        "```"
      ]
    ]
  },
  {
    "id": "scene.enemy_group",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Add three Area2D nodes named Enemy1, Enemy2 and Enemy3 and put all of them in the group \"enemies\".",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Enemy1",
        "class": "Area2D"
      },
      {
        "type": "node_exists",
        "path": "Enemy2",
        "class": "Area2D"
      },
      {
        "type": "node_exists",
        "path": "Enemy3",
        "class": "Area2D"
      },
      {
        "type": "expression",
        "code": "saved_group_members(\"enemies\") == 3"
      },
      {
        "type": "all_nodes_owned"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "for i in range(1, 4):",
        "\tvar enemy = Area2D.new()",
        "\tenemy.name = \"Enemy%d\" % i",
        "\troot.add_child(enemy)",
        "\tenemy.owner = root",
        "\tenemy.add_to_group(\"enemies\", true)",
        "print(\"Added 3 enemies to the 'enemies' group\")",
        "```"
      ]
    ]
  },
  {
