  {
    "id": "selftest.plan_execute",
    "mode": "plan",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Plan adding two nodes, StepOne and StepTwo.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "StepOne"
      },
      {
        "type": "node_exists",
        "path": "StepTwo"
      },
      {
        "type": "plan_steps_min",
        "value": 2
      },
      {
        "type": "expression",
        "code": "plan_lines(\"- [x] \") == 2 and plan_lines(\"- [ ] \") == 0"
      }
    ],
    "mock_replies": [
      [
        "1. Add a Node2D named StepOne.",
        "2. Add a Node2D named StepTwo."
      ],
      [
        "```gdscript",
        "var root = get_scene()",
        "var node = Node2D.new()",
        "node.name = \"StepOne\"",
        "root.add_child(node)",
        "node.owner = root",
        "print(\"Added StepOne\")",
        "```"
      ],
      [
        "```gdscript",
        "var root = get_scene()",
        "var node = Node2D.new()",
        "node.name = \"StepTwo\"",
        "root.add_child(node)",
        "node.owner = root",
        "print(\"Added StepTwo\")",
        "```"
      ]
    ],
    "mock_only": true,
    "execute_plan": true
  },
