  {
    "id": "selftest.failed_code_is_rolled_back",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Add a Sprite2D named Once.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Once",
        "class": "Sprite2D"
      },
      {
        "type": "node_count",
        "class": "Sprite2D",
        "min": 1,
        "max": 1
      },
      {
        "type": "retries_equal",
        "value": 1
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var node = Sprite2D.new()",
        "node.name = \"Once\"",
        "root.add_child(node)",
        "node.owner = root",
        "print(\"Added Once\")",
        "var missing = root.get_node(\"DoesNotExist\")",
        "missing.name = \"Renamed\"",
        "```"
      ],
      [
        "```gdscript",
        "var root = get_scene()",
        "var node = Sprite2D.new()",
        "node.name = \"Once\"",
        "root.add_child(node)",
        "node.owner = root",
        "print(\"Added Once\")",
        "```"
      ]
    ],
    "mock_only": true
  }
