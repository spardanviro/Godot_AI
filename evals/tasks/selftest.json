[
  {
    "id": "selftest.retry_syntax",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "Add a Node2D named Fixed.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Fixed"
      },
      {
        "type": "retries_equal",
        "value": 1
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene(",
        "var node = Node2D.new()",
        "```"
      ],
      [
        "```gdscript",
        "var root = get_scene()",
        "var node = Node2D.new()",
        "node.name = \"Fixed\"",
        "root.add_child(node)",
        "node.owner = root",
        "print(\"Added Fixed\")",
        "```"
      ]
    ],
    "mock_only": true
  },
