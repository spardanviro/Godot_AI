  {
    "id": "selftest.unicode",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D"
    },
    "prompt": "添加一个名为“主角”的 Node2D，位置在 (1, 2)。",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "主角"
      },
      {
        "type": "property",
        "path": "主角",
        "property": "position",
        "equals": "Vector2(1, 2)"
      }
    ],
    "mock_replies": [
      [
        "```gdscript",
        "var root = get_scene()",
        "var hero = Node2D.new()",
        "hero.name = \"主角\"",
        "hero.position = Vector2(1, 2)",
        "root.add_child(hero)",
        "hero.owner = root",
        "print(\"已添加节点“主角”，位置 (1, 2)\")",
        "```"
      ]
    ],
    "mock_only": true
  },
