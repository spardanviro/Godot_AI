  {
    "id": "selftest.resend_keeps_screenshot",
    "mode": "agent",
    "setup": {
      "scene_root": "Node2D",
      "screenshot": true
    },
    "prompt": "Look at the screenshot and add a Node2D named Seen.",
    "checks": [
      {
        "type": "run_completed"
      },
      {
        "type": "node_exists",
        "path": "Seen",
        "class": "Node2D"
      },
      {
        "type": "requests_max",
        "value": 2
      },
      {
        "type": "retries_equal",
        "value": 0
      }
    ],
    "mock_replies": [
      {
        "status": 400,
        "body": "{\"error\": {\"message\": \"Unsupported value: temperature does not support 0.7 with this model.\"}}"
      },
      {
        "requires_image": true,
        "text": [
          "```gdscript",
          "var root = get_scene()",
          "var node = Node2D.new()",
          "node.name = \"Seen\"",
          "root.add_child(node)",
          "node.owner = root",
          "print(\"Added Seen\")",
          "```"
        ]
      }
    ],
    "mock_only": true
  },
